        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    
    //Get the device type and quantity values from the RITM variables
    var deviceType = current.variables.gdr_device_type;
    var deviceQuantity = current.variables.gdr_quantity;
	gs.info(deviceQuantity + " "+ deviceType + " Triggered");

    //Create a GlideRecord object for Device Inventory Storage table and query it.
    var inventoryGr = new GlideRecord('x_1459741_device_0_device_inventory_storage');
    inventoryGr.addQuery('sys_id', deviceType);
    inventoryGr.query();
    //If record exists:- Get current stock count and convert
	if (inventoryGr.next()) {
    var currentStock = inventoryGr.getValue('u_total_quantity');
	// Subtract requested quantity from current stock
	var updateStock = Number(currentStock) - deviceQuantity;
	inventoryGr.setValue('u_total_quantity',updateStock.toString())
    //Update inventory record
    inventoryGr.update();
    }

})(current, previous);]]></script>
